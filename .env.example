# Optional. Only the "Read the paperwork" button and `npm run extract` use these.
# If both are missing, that path fails loud and does not invent an extraction.
# The synthetic fingerprint and the local issuer do not need them.
OPENAI_API_KEY=
# Optional OpenAI-compatible base, without a trailing path past /v1.
# Example: https://api.openai.com/v1
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Below this, a live read is refused and no mint is offered. Default 0.8.
CONFIDENCE_THRESHOLD=0.8

# CLI mint only (`npm run extract`). The model never receives this value.
# The web app's "Use local issuer" button does not read this variable.
# It signs with Hardhat's published account #0 against loopback only.
# ISSUER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
ISSUER_PRIVATE_KEY=
RPC_URL=http://127.0.0.1:8545

# Optional. Defaults to the local Hardhat node.
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
