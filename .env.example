# Required only for AI reading of pasted reports. Synthetic examples work without it.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=meta-llama/Llama-3.3-70B-Instruct

# Below this, a live read is refused and no mint is offered. Default 0.8.
CONFIDENCE_THRESHOLD=0.8

# Optional deployer key for `npm run deploy:hoodi`. Keep this private and do not commit it.
DEPLOYER_PRIVATE_KEY=
HOODI_RPC_URL=https://rpc.hoodi.ethpandaops.io

# Optional. The app defaults to the RPC configured for Hoodi in lib/chain.ts.
NEXT_PUBLIC_RPC_URL=

# Optional. Only the WalletConnect QR code inside ConnectKit needs this.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional CLI-only signer for the local Hardhat extract command.
ISSUER_PRIVATE_KEY=
RPC_URL=http://127.0.0.1:8545
